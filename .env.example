# AI 機能は次のどちらかで使えます
#  A. Claude のプラン (Pro / Max): Claude Code をインストールして `claude` → /login しておけば設定不要
#  B. Claude API キー (従量課金): 下に書く (書いた場合はこちらが優先)
ANTHROPIC_API_KEY=
# 両方ある場合に呼び出し方を固定する: auto / subscription / api
# CODEMAP_AI=auto
# 非公開リポジトリを取得する場合
GITHUB_TOKEN=
# モデル (プラン経由なら opus / sonnet / haiku などの別名も可)
# CODEMAP_MODEL=claude-opus-5-5
# CODEMAP_EFFORT=medium
